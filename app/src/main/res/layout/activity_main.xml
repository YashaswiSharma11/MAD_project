<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background"
    tools:context=".MainActivity">

    <!-- Top Hero Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1.2"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@drawable/bg_gradient_header"
        android:padding="28dp">

        <ImageView
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:src="@drawable/ic_civic_logo"
            android:contentDescription="CivicConnect Logo"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CIVICCONNECT"
            android:textSize="32sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:letterSpacing="0.05" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Report • Track • Resolve"
            android:textSize="15sp"
            android:textColor="#93C5FD"
            android:layout_marginTop="6dp" />
    </LinearLayout>

    <!-- Bottom Role Selection Container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:padding="28dp"
        android:gravity="center">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Continue As"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:layout_marginBottom="24dp" />

        <!-- Citizen Role Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/citizenButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="CITIZEN"
            android:textSize="16sp"
            android:textStyle="bold"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            app:icon="@drawable/ic_citizen"
            app:iconGravity="textStart"
            app:iconPadding="12dp"
            app:iconTint="@color/white"
            app:cornerRadius="16dp"
            android:backgroundTint="@color/secondary"
            android:layout_marginBottom="16dp"
            xmlns:app="http://schemas.android.com/apk/res-auto" />

        <!-- Official Role Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/officialButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="OFFICIAL"
            android:textSize="16sp"
            android:textStyle="bold"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            app:icon="@drawable/ic_official"
            app:iconGravity="textStart"
            app:iconPadding="12dp"
            app:iconTint="@color/primary"
            app:cornerRadius="16dp"
            android:backgroundTint="@color/surface_variant"
            android:textColor="@color/primary"
            app:strokeColor="@color/card_stroke"
            app:strokeWidth="1.5dp"
            xmlns:app="http://schemas.android.com/apk/res-auto" />

    </LinearLayout>

</LinearLayout>