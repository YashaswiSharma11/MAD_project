<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/background"
    tools:context=".AnalyticsActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_gradient_header"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="36dp"
            android:paddingBottom="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="System Metrics"
                android:textSize="13sp"
                android:textColor="#93C5FD"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Civic Analytics"
                android:textSize="28sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Resolution Rate Gauge Banner -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="3dp"
                app:cardBackgroundColor="@color/status_resolved_bg"
                app:strokeColor="@color/status_resolved"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="20dp"
                    android:gravity="center_vertical">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="RESOLUTION PERFORMANCE"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="@color/status_resolved" />

                        <TextView
                            android:id="@+id/resolutionRateTextView"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Resolution Rate: 78.5%"
                            android:textSize="22sp"
                            android:textStyle="bold"
                            android:textColor="@color/status_resolved"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📈"
                        android:textSize="32sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Overall Stats -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/surface"
                app:strokeColor="@color/card_stroke"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="OVERALL STATISTICS"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/secondary"
                        android:layout_marginBottom="12dp" />

                    <TextView
                        android:id="@+id/totalTextView"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Total Complaints: 0"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary"
                        android:layout_marginBottom="6dp" />

                    <TextView
                        android:id="@+id/pendingTextView"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Pending: 0"
                        android:textSize="15sp"
                        android:textColor="@color/status_pending"
                        android:layout_marginBottom="6dp" />

                    <TextView
                        android:id="@+id/inProgressTextView"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="In Progress: 0"
                        android:textSize="15sp"
                        android:textColor="@color/status_in_progress"
                        android:layout_marginBottom="6dp" />

                    <TextView
                        android:id="@+id/resolvedTextView"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Resolved: 0"
                        android:textSize="15sp"
                        android:textColor="@color/status_resolved" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Severity Breakdown -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/surface"
                app:strokeColor="@color/card_stroke"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="SEVERITY BREAKDOWN"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/secondary"
                        android:layout_marginBottom="12dp" />

                    <TextView
                        android:id="@+id/lowTextView"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Low: 0"
                        android:textSize="15sp"
                        android:textColor="@color/severity_low"
                        android:layout_marginBottom="6dp" />

                    <TextView
                        android:id="@+id/mediumTextView"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Medium: 0"
                        android:textSize="15sp"
                        android:textColor="@color/severity_medium"
                        android:layout_marginBottom="6dp" />

                    <TextView
                        android:id="@+id/highTextView"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="High: 0"
                        android:textSize="15sp"
                        android:textColor="@color/severity_high"
                        android:layout_marginBottom="6dp" />

                    <TextView
                        android:id="@+id/criticalTextView"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Critical: 0"
                        android:textSize="15sp"
                        android:textColor="@color/severity_critical" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Category Statistics -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/surface"
                app:strokeColor="@color/card_stroke"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="CATEGORY BREAKDOWN"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/secondary"
                        android:layout_marginBottom="10dp" />

                    <TextView
                        android:id="@+id/categoryStatsTextView"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Category statistics..."
                        android:textSize="15sp"
                        android:textColor="@color/text_secondary"
                        android:lineSpacingExtra="4dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Location Statistics -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/surface"
                app:strokeColor="@color/card_stroke"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="STATE-WISE DISTRIBUTION"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/secondary"
                        android:layout_marginBottom="10dp" />

                    <TextView
                        android:id="@+id/locationStatsTextView"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Location statistics..."
                        android:textSize="15sp"
                        android:textColor="@color/text_secondary"
                        android:lineSpacingExtra="4dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </LinearLayout>
</ScrollView>