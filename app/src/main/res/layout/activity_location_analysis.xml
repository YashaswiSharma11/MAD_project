<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    tools:context=".LocationAnalysisActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Title -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="LOCATION ANALYSIS"
            android:textSize="28sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="25dp" />

        <!-- State Selection -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Select State"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <Spinner
            android:id="@+id/stateSpinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="25dp" />

        <!-- State Summary -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="STATE SUMMARY"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="10dp" />

        <TextView
            android:id="@+id/totalTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Total Complaints: 0"
            android:textSize="18sp"
            android:padding="10dp" />

        <TextView
            android:id="@+id/pendingTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Pending: 0"
            android:textSize="18sp"
            android:padding="10dp" />

        <TextView
            android:id="@+id/inProgressTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="In Progress: 0"
            android:textSize="18sp"
            android:padding="10dp" />

        <TextView
            android:id="@+id/resolvedTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Resolved: 0"
            android:textSize="18sp"
            android:padding="10dp"
            android:layout_marginBottom="25dp" />

        <!-- City-wise Analysis -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CITY-WISE COMPLAINTS"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="10dp" />

        <TextView
            android:id="@+id/cityStatsTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="City-wise statistics will appear here"
            android:textSize="17sp"
            android:padding="10dp"
            android:layout_marginBottom="25dp" />

        <!-- Area-wise Analysis -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="AREA-WISE ANALYSIS"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="10dp" />

        <TextView
            android:id="@+id/areaStatsTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Area-wise statistics will appear here"
            android:textSize="17sp"
            android:padding="10dp"
            android:layout_marginBottom="25dp" />

        <!-- View Complaints -->

        <Button
            android:id="@+id/viewComplaintsButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="VIEW COMPLAINTS" />

    </LinearLayout>

</ScrollView>